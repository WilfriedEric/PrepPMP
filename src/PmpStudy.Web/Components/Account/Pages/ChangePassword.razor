@page "/Account/ChangePassword"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<PageTitle>Mot de passe · PMP Study</PageTitle>

<h1 class="auth-title">Changer le mot de passe</h1>
<p class="auth-lead"><a href="" class="auth-link">Retour à l'application</a></p>

<FormError Message="@error" />
@if (done)
{
    <div class="auth-success" role="status">Mot de passe modifié.</div>
}

<EditForm Model="Input" method="post" OnValidSubmit="Change" FormName="change-password" class="auth-form">
    <DataAnnotationsValidator />
    <div class="field">
        <label for="current">Mot de passe actuel</label>
        <InputText id="current" type="password" @bind-Value="Input.OldPassword" autocomplete="current-password" />
        <ValidationMessage For="() => Input.OldPassword" class="field-error" />
    </div>
    <div class="field">
        <label for="new">Nouveau mot de passe</label>
        <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.NewPassword" class="field-error" />
    </div>
    <div class="field">
        <label for="confirm">Confirmation</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" class="field-error" />
    </div>
    <button type="submit" class="btn-primary">Enregistrer</button>
</EditForm>

@code {
    private string? error;
    private bool done;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task Change()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null) { error = "Session expirée : reconnecte-toi."; return; }
        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            error = result.Errors.Any(e => e.Code == "PasswordMismatch")
                ? "Mot de passe actuel incorrect."
                : "Le nouveau mot de passe doit faire 10 caractères minimum, avec majuscule, minuscule, chiffre et symbole.";
            return;
        }
        await SignInManager.RefreshSignInAsync(user);
        done = true;
        Input = new();
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Obligatoire.")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Obligatoire.")]
        [StringLength(100, MinimumLength = 10, ErrorMessage = "10 caractères minimum.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "Les deux mots de passe ne correspondent pas.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
