@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ErrorLogService Errors

<MudThemeProvider Theme="theme" @bind-IsDarkMode="dark" ObserveSystemThemeChange="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => drawerOpen = !drawerOpen" aria-label="Menu" />
        <MudText Typo="Typo.h6" Class="ml-2">PMP Study</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-2 d-none d-sm-flex">@context.User.Identity?.Name</MudText>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="" />
                    <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" aria-label="Se déconnecter" />
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Today">Aujourd'hui</MudNavLink>
            <MudNavLink Href="cours" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">Cours</MudNavLink>
            <MudNavLink Href="notes" Icon="@Icons.Material.Filled.StickyNote2">Notes</MudNavLink>
            <MudNavLink Href="entrainement" Icon="@Icons.Material.Outlined.Timer">Entraînement</MudNavLink>
            <MudNavLink Href="examens" Icon="@Icons.Material.Filled.Assignment">Examens blancs</MudNavLink>
            <MudNavLink Href="erreurs" Icon="@Icons.Material.Filled.ErrorOutline">
                Carnet d'erreurs
                @if (dueErrors > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">@dueErrors</MudChip>
                }
            </MudNavLink>
            <MudNavLink Href="bilan" Icon="@Icons.Material.Filled.Insights">Bilan</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="admin/import" Icon="@Icons.Material.Filled.UploadFile">Import et réglages</MudNavLink>
            <MudNavLink Href="admin/questions" Icon="@Icons.Material.Filled.QuestionAnswer">Banque de questions</MudNavLink>
            <MudNavLink Href="Account/Manage" ForceLoad="true" Icon="@Icons.Material.Filled.Security">Compte et 2FA</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 px-2 px-sm-4">
            <TwoFactorReminder />
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;
    private bool dark;
    private int dueErrors;

    private readonly MudTheme theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#2d4a7a", Secondary = "#c2410c", AppbarBackground = "#2d4a7a" },
        PaletteDark = new PaletteDark { Primary = "#8fb3ff", Secondary = "#fb923c" },
        LayoutProperties = new LayoutProperties { DrawerWidthLeft = "240px" },
    };

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await RefreshAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async Task RefreshAsync() => dueErrors = await Errors.CountDueAsync();

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
