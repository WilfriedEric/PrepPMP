@page "/"
@inject StudyService Study
@inject SessionService Sessions
@inject IStudyClock Clock
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Aujourd'hui · PMP Study</PageTitle>

@if (today is null)
{
    <div class="today-head">
        <div><MudSkeleton Width="220px" Height="44px" /><MudSkeleton Width="160px" /></div>
    </div>
    <div class="today-grid">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-lg" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-lg" />
    </div>
    return;
}

<header class="today-head">
    <div>
        <h1 class="today-title">@Greeting</h1>
        <div class="today-date">@today.Date.ToString("dddd d MMMM", Fr)@(today.PlanDay is { } wd ? $", semaine {wd.Week}" : "")</div>
    </div>
    <div class="today-countdown">
        <span class="today-countdown-number">@Math.Max(0, today.DaysToExam)</span>
        <span class="today-countdown-label">jours avant l'examen (@today.ExamDate.ToString("d MMM", Fr))</span>
    </div>
</header>

@if (today.OpenSession is { } open)
{
    <div class="resume">
        <MudIcon Icon="@Icons.Material.Rounded.PlayCircle" Color="Color.Primary" />
        <div><b>@open.Title</b> est en cours.</div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   Href="@(open.Type == SessionType.Exam ? $"examen/{open.Id}" : $"session/{open.Id}")">Reprendre</MudButton>
    </div>
}

<div class="today-grid">
    <section class="panel panel-accent" aria-labelledby="plan-title">
        <h2 id="plan-title">Plan du jour</h2>
        @if (today.PlanDay is not { } day)
        {
            <div class="empty">
                <p>Rien de prévu aujourd'hui. Règle ton plan de révision : dates, pages ou sections par jour, jours de repos. Il se calcule tout seul.</p>
                <div class="actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="plan">Configurer le plan</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="StartDailyTraining" Disabled="busy">Entraînement libre</MudButton>
                </div>
            </div>
        }
        else
        {
            <div class="panel-sub">@(string.IsNullOrWhiteSpace(day.Label) ? ReportService.StatusLabel(day.Status) : day.Label)</div>
            <ul class="task-list">
                <li class="task @(today.PagesDone ? "done" : "")">
                    <span class="task-check"><MudIcon Icon="@Icons.Material.Rounded.Check" Size="Size.Small" /></span>
                    <span class="task-text">
                        @if (day.PageFrom is { } from && day.PageTo is { } to)
                        {
                            <span>Lire les pages @from à @to</span>
                        }
                        else
                        {
                            <span>Pas de lecture prévue</span>
                        }
                    </span>
                    <span class="task-meta">@(day.PageFrom is { } f2 && day.PageTo is { } t2 ? $"{t2 - f2 + 1} p." : "")</span>
                </li>
                <li class="task @(today.QuestionsDone ? "done" : "")">
                    <span class="task-check"><MudIcon Icon="@Icons.Material.Rounded.Check" Size="Size.Small" /></span>
                    <span class="task-text">Répondre aux questions</span>
                    <span class="task-meta">@today.QuestionsAnsweredToday / @day.QuestionGoal</span>
                </li>
            </ul>
            <MudProgressLinear Class="mt-5" Color="Color.Primary" Value="@DayProgress" Size="Size.Small" aria-label="Avancement du jour" />
            @if (day.Chapters.Count > 0 || day.EcoTasks.Count > 0)
            {
                <div class="tags">
                    @foreach (var c in day.Chapters)
                    {
                        <a class="tag" href="@($"cours/{c.StartPage + today.PageOffset}")">@c.Code @c.Title</a>
                    }
                    @foreach (var t in day.EcoTasks)
                    {
                        <span class="tag" title="@t.Title">@t.Code</span>
                    }
                </div>
            }
            <div class="actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.MenuBook" Href="@ResumeHref">
                    @(today.LastPage is null ? "Ouvrir le cours" : "Reprendre la lecture")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Timer" OnClick="StartDailyTraining" Disabled="busy">
                    Questions du jour
                </MudButton>
            </div>
        }
    </section>

    <div class="side-stack">
        <section class="panel" aria-labelledby="errors-title">
            <h2 id="errors-title">Carnet d'erreurs</h2>
            <div class="metric-row" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
                <div class="metric">
                    <div class="metric-value @(today.ErrorsDue > 0 ? "warn" : "")">@today.ErrorsDue</div>
                    <div class="metric-label">à revoir aujourd'hui</div>
                </div>
                <div class="metric">
                    <div class="metric-value">@today.ErrorsIncomplete</div>
                    <div class="metric-label">à compléter</div>
                </div>
            </div>
            <div class="actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(today.ErrorsDue == 0 || busy)" OnClick="ReplayDue" StartIcon="@Icons.Material.Rounded.Replay">Rejouer</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="erreurs">Ouvrir le carnet</MudButton>
            </div>
        </section>

        <section class="panel" aria-labelledby="stats-title">
            <h2 id="stats-title">Aujourd'hui</h2>
            <div class="metric-row">
                <div class="metric">
                    <div class="metric-value">@Math.Round(today.ReadingMinutesToday)</div>
                    <div class="metric-label">min de lecture</div>
                </div>
                <div class="metric">
                    <div class="metric-value">@today.QuestionsAnsweredToday</div>
                    <div class="metric-label">questions</div>
                </div>
                <div class="metric">
                    <div class="metric-value">@(today.QuestionsAnsweredToday == 0 ? "-" : $"{100.0 * today.CorrectToday / today.QuestionsAnsweredToday:0}%")</div>
                    <div class="metric-label">réussite</div>
                </div>
            </div>
            @if (today.NextSimulation is { } sim)
            {
                <div class="panel-sub mt-4">Prochaine simulation le @sim.ToString("d MMMM", Fr), dans @(sim.DayNumber - today.Date.DayNumber) jours.</div>
            }
        </section>
    </div>
</div>

@if (today.Week.Count > 0)
{
    <section class="panel mt-5" aria-labelledby="week-title">
        <h2 id="week-title">Ta semaine</h2>
        <div class="week-strip">
            @foreach (var d in today.Week)
            {
                <div class="week-day @StatusCss(d) @(d.Date == today.Date ? "today" : "")">
                    <div class="week-day-name">@d.Date.ToString("ddd", Fr)</div>
                    <div class="week-day-num">@d.Date.Day</div>
                    <div class="week-day-status">@ReportService.StatusLabel(d.Status)</div>
                </div>
            }
        </div>
    </section>
}

@code {
    private static readonly System.Globalization.CultureInfo Fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
    private TodaySummary? today;
    private bool busy;

    private string Greeting
    {
        get
        {
            var hour = Clock.ToLocal(Clock.UtcNow).Hour;
            return hour < 5 ? "Bonsoir" : hour < 18 ? "Bonjour" : "Bonsoir";
        }
    }

    protected override async Task OnInitializedAsync() => today = await Study.TodayAsync();

    private string ResumeHref => today?.LastPage is { } p ? $"cours/{p}"
        : today?.PlanDay?.PageFrom is { } from ? $"cours/{from + today.PageOffset}" : "cours";

    private double DayProgress
    {
        get
        {
            if (today?.PlanDay is not { } d) return 0;
            var parts = 0.0;
            parts += today.PagesDone ? 50 : 0;
            parts += d.QuestionGoal == 0 ? 50 : Math.Min(50, 50.0 * today.QuestionsAnsweredToday / d.QuestionGoal);
            return parts;
        }
    }

    private static string StatusCss(StudyPlanDay d) => d.Status switch
    {
        PlanDayStatus.Done => "done",
        PlanDayStatus.InProgress => "progress",
        PlanDayStatus.Skipped => "skipped",
        _ => "",
    };

    private async Task StartDailyTraining()
    {
        busy = true;
        try
        {
            var remaining = today?.PlanDay is { } d ? Math.Max(10, d.QuestionGoal - today.QuestionsAnsweredToday) : 20;
            var id = await Sessions.CreateTrainingAsync(new TrainingRequest
            {
                Count = remaining,
                EcoTasks = today?.PlanDay?.EcoTasks.Select(t => t.Code).ToList() ?? [],
            });
            Nav.NavigateTo($"session/{id}");
        }
        catch (SessionException)
        {
            // Pas assez de questions sur les tâches du jour : entraînement sans filtre.
            try { Nav.NavigateTo($"session/{await Sessions.CreateTrainingAsync(new TrainingRequest { Count = 20 })}"); }
            catch (SessionException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        }
        finally { busy = false; }
    }

    private async Task ReplayDue()
    {
        busy = true;
        try { Nav.NavigateTo($"session/{await Sessions.CreateErrorReplayAsync(dueOnly: true)}"); }
        catch (SessionException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        finally { busy = false; }
    }
}
