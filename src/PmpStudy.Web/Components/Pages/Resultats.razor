@page "/session/{Id:int}/resultats"
@inject SessionService Sessions
@inject ErrorLogService Errors
@inject ContentService Content
@inject IStudyClock Clock
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Résultats — @session?.Title</PageTitle>

@if (session is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
    <MudText Typo="Typo.h4">@session.Title</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Href="@(session.Type == SessionType.Exam ? "examens" : "entrainement")">Retour</MudButton>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Elevation="1" Class="pa-4 text-center">
            <MudText Typo="Typo.h2">@session.ScorePercent?.ToString("0.#") %</MudText>
            <MudText>@session.CorrectCount / @session.Items.Count justes</MudText>
            <LevelChip Level="Scoring.LevelFor(session.ScorePercent ?? 0)" />
            <MudText Typo="Typo.body2" Class="mt-3">
                Durée : @(Countdown.Format((session.EndUtc ?? Clock.UtcNow) - session.StartUtc)) ·
                moyenne @(session.Items.Count == 0 ? 0 : session.Items.Average(i => i.TimeSeconds).ToString("0")) s / question
            </MudText>
            <MudText Typo="Typo.caption" Class="d-block mt-2">
                Niveaux internes : ≥ 80 % au-dessus de la cible, 70–79 % cible, 60–69 % sous la cible, &lt; 60 % à renforcer.
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudPaper Elevation="1" Class="pa-4">
            <MudTabs Elevation="0" Rounded="true" PanelClass="pt-3">
                <MudTabPanel Text="Domaines"><ScoreTable Title="Domaine" Lines="Scoring.ByDomain(session.Items)" /></MudTabPanel>
                <MudTabPanel Text="Approches"><ScoreTable Title="Approche" Lines="Scoring.ByApproach(session.Items)" /></MudTabPanel>
                <MudTabPanel Text="Tâches ECO"><ScoreTable Title="Tâche" Lines="Scoring.ByEcoTask(session.Items)" /></MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-6 mb-2" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">Correction</MudText>
    <MudSpacer />
    <MudChipSet T="string" SelectedValue="filter" SelectedValueChanged="OnFilter" CheckMark="true" SelectionMode="SelectionMode.SingleSelection">
        <MudChip T="string" Value="@("errors")">Erreurs et doutes (@MissCount)</MudChip>
        <MudChip T="string" Value="@("flagged")">Marquées</MudChip>
        <MudChip T="string" Value="@("all")">Toutes</MudChip>
    </MudChipSet>
</MudStack>
<MudText Typo="Typo.body2" Class="mb-3">
    Chaque erreur ou doute est entré dans le <MudLink Href="erreurs">carnet</MudLink>. Remplis « pourquoi » et « piège » maintenant, tant que c'est frais.
</MudText>

@foreach (var it in Visible)
{
    <MudPaper Elevation="1" Class="pa-4 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.overline">Question @it.Order</MudText>
            @if (it.Flagged) { <MudIcon Icon="@Icons.Material.Filled.Flag" Color="Color.Warning" Size="Size.Small" /> }
            @if (it.Doubt) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary">doute</MudChip> }
            <MudSpacer />
            <MudText Typo="Typo.caption">@it.TimeSeconds s</MudText>
        </MudStack>
        <QuestionView Question="it.Question!" Selected="Scoring.ParseAnswer(it.AnswerJson).ToList()" ReadOnly="true" ShowCorrection="true" IsCorrect="it.IsCorrect" />
        @if (entries.TryGetValue(it.QuestionId, out var entry))
        {
            <MudPaper Outlined="true" Class="pa-3 mt-3 error-entry">
                <MudText Typo="Typo.subtitle2">Carnet d'erreurs @(entry.IsIncomplete ? "— incomplet" : "")</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4"><MudTextField @bind-Value="entry.Why" Label="Pourquoi je me suis trompé" Lines="2" AutoGrow="true" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField @bind-Value="entry.Trap" Label="Le piège" Lines="2" AutoGrow="true" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField @bind-Value="entry.MindsetReflex" Label="Réflexe mindset" Lines="2" AutoGrow="true" Margin="Margin.Dense" /></MudItem>
                </MudGrid>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="() => SaveEntry(entry)">Enregistrer</MudButton>
            </MudPaper>
        }
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private StudySession? session;
    private Dictionary<int, ErrorEntry> entries = [];
    private string filter = "errors";

    private int MissCount => session?.Items.Count(i => i.IsCorrect != true || i.Doubt) ?? 0;

    private IEnumerable<SessionItem> Visible => (session?.Items ?? []).OrderBy(i => i.Order).Where(i => filter switch
    {
        "flagged" => i.Flagged,
        "all" => true,
        _ => i.IsCorrect != true || i.Doubt,
    });

    protected override async Task OnInitializedAsync()
    {
        session = await Sessions.GetAsync(Id);
        if (session is null) { Nav.NavigateTo("entrainement"); return; }
        if (!session.IsFinished)
        {
            Nav.NavigateTo(session.Type == SessionType.Exam ? $"examen/{Id}" : $"session/{Id}", replace: true);
            return;
        }
        var ids = session.Items.Select(i => i.QuestionId).ToHashSet();
        entries = (await Errors.ListAsync(ErrorFilter.All))
            .Where(e => e.QuestionId is { } q && ids.Contains(q))
            .ToDictionary(e => e.QuestionId!.Value);
    }

    private void OnFilter(string? value) => filter = value ?? "errors";

    private async Task SaveEntry(ErrorEntry entry)
    {
        await Errors.SaveDetailsAsync(entry.Id, entry.Why, entry.Trap, entry.MindsetReflex, entry.EcoTaskId, entry.Summary);
        Snackbar.Add("Entrée du carnet enregistrée", Severity.Success);
    }
}
